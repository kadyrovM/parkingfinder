<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F1A">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A2E"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🅿 Поиск Парковки"
            android:textColor="#E0E0FF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnFindParking"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="📍 Найти парковки рядом"
            android:backgroundTint="#7B68EE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Нажми кнопку для поиска"
            android:textColor="#7B7BAA"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Карта -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Список парковок -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerParking"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#1A1A2E"
        android:padding="8dp"/>

</LinearLayout>